# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# IMPERIONX SHOWROOM & AUTOMATION ENGINE CONFIGURATION
# ==============================================================================

# SUPABASE CLIENT CREDENTIALS (Client-Safe)
# Configured for public showroom queries via Row Level Security (RLS)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# SUPABASE BACKEND SERVICE-ROLE (Server-Side Only - NEVER expose to browser)
# Used exclusively for admin mutations, automated crawler jobs, and storage signing
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# DISCOVERY ENGINE ADAPTERS (Server-Side Only)
# Envato Market API Bearer Token (catalog:read)
ENVATO_API_TOKEN="your-envato-api-token"

# Webflow OAuth 2.0 Access Token
WEBFLOW_API_TOKEN="your-webflow-api-token"

# IMPERIONX AGENCY DESK
# Official WhatsApp Business Line for direct client commission routing (E.164 format)
VITE_WHATSAPP_AGENCY_NUMBER="18005550199"
